# Server
PORT=8081

# Frontend
FRONTEND_URL=http://localhost:5173
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200

# Security toggle
GATEWAY_SECURITY_ENABLED=false

# JWT options (required only if GATEWAY_SECURITY_ENABLED=true)
# Option 1: JWK Set URI from IAM/OIDC provider
GATEWAY_JWT_JWK_SET_URI=
# Option 2: HMAC secret
GATEWAY_JWT_SECRET=

# Microservices
SUBSCRIPTIONS_SERVICE_URL=https://microservice-subscriptions-service.onrender.com
ANALYTICS_SERVICE_URL=https://microservice-analytics-service.onrender.com
DEVICE_MANAGEMENT_SERVICE_URL=https://microservice-device-management-service-jm7b.onrender.com
PAYMENTS_SERVICE_URL=https://microservice-payments-service.onrender.com
ALERT_SERVICE_URL=https://microservice-alert-service.onrender.com
IAM_SERVICE_URL=https://microservice-iam-service.onrender.com
ENERGY_MONITORING_SERVICE_URL=http://localhost:8084
