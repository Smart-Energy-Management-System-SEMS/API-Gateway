# Runtime
PORT=8080
SERVER_PORT=${PORT:8080}
SPRING_PROFILES_ACTIVE=prod

# Core integrations
CONFIG_SERVICE_URL=
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
DATABASE_URL=
JWT_SECRET=

# API Gateway routes
IAM_SERVICE_URL=
DEVICE_MANAGEMENT_SERVICE_URL=
ALERT_SERVICE_URL=
SUBSCRIPTIONS_SERVICE_URL=
PAYMENTS_SERVICE_URL=
ANALYTICS_SERVICE_URL=
ENERGY_MONITORING_SERVICE_URL=

# Optional gateway settings
API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_GATEWAY_AUTH_REQUIRED=false
API_GATEWAY_TIMEOUT_SECONDS=30
API_GATEWAY_USE_DEPLOY_URLS=false
CONFIG_SERVICE_SERVICES_ENDPOINT=/api/v1/config/services
CONFIG_SERVICE_GATEWAY_ENDPOINT=/api/v1/config/api-gateway
CONFIG_SERVICE_REFRESH_INTERVAL_SECONDS=0
CONFIG_SERVICE_RETRY_MAX_ATTEMPTS=5
CONFIG_SERVICE_RETRY_BACKOFF_MILLIS=1000
GATEWAY_JWT_JWK_SET_URI=
GATEWAY_JWT_SECRET=
