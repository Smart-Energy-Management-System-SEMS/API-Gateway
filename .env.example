# API Gateway
API_GATEWAY_PORT=8081
API_GATEWAY_BASE_URL_LOCAL=http://localhost:8081
API_GATEWAY_BASE_URL_DEPLOY=
API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_GATEWAY_AUTH_REQUIRED=false
API_GATEWAY_TIMEOUT_SECONDS=30
API_GATEWAY_USE_DEPLOY_URLS=false

# Config Service
CONFIG_SERVICE_BASE_URL=http://localhost:8090
CONFIG_SERVICE_SERVICES_ENDPOINT=/api/v1/config/services
CONFIG_SERVICE_GATEWAY_ENDPOINT=/api/v1/config/api-gateway
CONFIG_SERVICE_REFRESH_INTERVAL_SECONDS=0
CONFIG_SERVICE_RETRY_MAX_ATTEMPTS=5
CONFIG_SERVICE_RETRY_BACKOFF_MILLIS=1000

# Optional legacy/fallback service URLs
SUBSCRIPTIONS_SERVICE_URL=http://localhost:8082
ANALYTICS_SERVICE_URL=http://localhost:8004
DEVICE_MANAGEMENT_SERVICE_URL=http://localhost:8083
PAYMENTS_SERVICE_URL=http://localhost:8085
ALERT_SERVICE_URL=http://localhost:8085
IAM_SERVICE_URL=http://localhost:8080
ENERGY_MONITORING_SERVICE_URL=http://localhost:8001

# Optional JWT options (required only if API_GATEWAY_AUTH_REQUIRED=true)
GATEWAY_JWT_JWK_SET_URI=
GATEWAY_JWT_SECRET=
